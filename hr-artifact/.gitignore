# Local Netlify CLI
.netlify

# Env (never commit secrets)
.env
.env.*
!.env.example

# Google service account material (never commit a real key)
netlify/.secrets/
*.sa.json
google-sa.json
google-service-account.json

# HR backup JSON restored via Settings in the artifact — never commit
*.backup.json
*backup*.json
backups/
exports/

# Dependencies / OS
node_modules/
.DS_Store

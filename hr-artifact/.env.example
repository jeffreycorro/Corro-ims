# CorConDev HR artifact — set these on the SEPARATE Netlify site
# (Site settings → Environment variables). Never commit real values.
# Do not put SUPABASE_SERVICE_ROLE in any browser file.

# Same Supabase project as the company portal (corcondev-portal).
# Staff sign in with their portal email + password. There is no
# separate HR site password in the default flow.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Functions only. Never expose to the browser or the shim.
# Used for docs/locks and (server-side) profile lookup.
SUPABASE_SERVICE_ROLE=your-service-role-key

# HMAC key for the httpOnly HR session cookie (Functions-scoped).
# Generate with: openssl rand -hex 32
# If unset, the cookie is signed from a hash of SUPABASE_SERVICE_ROLE.
HR_SESSION_SECRET=
# Deprecated. Do not set on Netlify Functions (not a login password;
# leftover values waste the 4KB Lambda env budget).
# HR_GATE_SECRET=

# Optional legacy shared-password wall. Default off. Leave unset.
# Only enable if you still need a second password in front of Auth.
# HR_GATE_REQUIRED=true
# HR_GATE_PASSWORD=

# Supabase email/password is on by default when URL + anon key are set.
# Set false only to disable Auth (not recommended).
# SUPABASE_AUTH_ENABLED=true

# --- AI drafting (window.claude.use("sample")) ---
# Functions only. Never put this in the shim, index.html, or a public env.
ANTHROPIC_API_KEY=
# Optional model overrides. Default is claude-sonnet-4-5 for both tiers.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MODEL_COMPLEX=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_MAX_TOKENS_COMPLEX=8192

# --- Google Drive (window.claude.use("mcp")) ---
# NEVER Functions-scope the full JSON on Netlify (AWS 4KB Lambda env limit).
# Production: upload once to Netlify Blobs, then delete this env var:
#   npx netlify blobs:set hr-secrets google-service-account --input ./google-sa.json
# Also supported: keep GOOGLE_SERVICE_ACCOUNT_JSON as Builds-only (the
# Netlify build copies it into the functions bundle). Local netlify dev
# may still set the JSON or a file path here.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/google-sa.json
# Tiny Functions-safe Blobs hint. netlify.toml sets this to 1 so production
# auth/drive always try hr-secrets / google-service-account.
# GOOGLE_SERVICE_ACCOUNT_BLOB=1
# Share the service account email on the HR Shared Drive / 201 / memo folders
# with at least Content Manager (upload) or Viewer (search/read).
# Never commit the real JSON.
# Leave / Cash Advance uploads. Files the service account creates in a
# user's My Drive count against the service account, even when that folder
# is shared with it as Editor. This service account's My Drive is full.
# Preferred unblock (Functions scope on site corcondev-hr, then redeploy):
#   1. Workspace Admin → Security → Access and data control → API controls
#      → Domain-wide delegation → Add new.
#      Client ID: the service account's numeric client_id (not client_email).
#      Scope: https://www.googleapis.com/auth/drive
#   2. Set GOOGLE_DRIVE_DELEGATED_USER to a Workspace mailbox that owns, or
#      has free space in, the Leave / Cash Advance / 201 folders.
# Canonical name is GOOGLE_DRIVE_DELEGATED_USER. GOOGLE_DRIVE_IMPERSONATE and
# GOOGLE_IMPERSONATE_USER are accepted aliases — set only one.
# A Shared Drive (service account as Content manager) is an alternative,
# not a requirement.
# GOOGLE_DRIVE_DELEGATED_USER=hr@example.com
# Optional: send image/PDF bytes to Anthropic when a file has no text layer.
# Off by default — folder-wide scans would be slow and expensive.
# GOOGLE_DRIVE_OCR=true

# --- Dictation / Whisper (window.claude.use("transcribe")) ---
# Functions only. Never put this in the shim, index.html, or a public env.
# Enables hold-to-talk on memo drafting and Ask the records.
OPENAI_API_KEY=
# Optional. Default tries gpt-transcribe, then gpt-4o-transcribe, then whisper-1.
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Optional comma-separated language hints for newer models (e.g. en,tl). Leave
# unset so the model auto-detects Taglish / mixed speech.
# OPENAI_TRANSCRIBE_LANGUAGES=
# Optional prompt / keyword overrides for Filipino names and workplace terms.
# OPENAI_TRANSCRIBE_PROMPT=
# OPENAI_TRANSCRIBE_KEYWORDS=NTE,201 file,memorandum,Cebu

# --- Applicants bulk ingest (GoDaddy extractor / HR JSON import) ---
# Functions only. Shared secret for POST /.netlify/functions/applicants-ingest.
# Generate with: openssl rand -hex 32
# Set on Netlify site corcondev-hr, then redeploy. Rotate if leaked.
# Never commit the real value. Leave empty here.
HR_APPLICANTS_INGEST_KEY=

# Optional IMAP pull of hrcorcondev@gmail.com into Pipeline.
# Functions only, small values (email + Gmail app password). Never commit.
# Cassie clicks Recruitment → Pipeline → Import from email after these are set
# and the site is redeployed. Unset = UI still offers JSON / mailbox file import.
# HR_APPLICANTS_IMAP_USER=hrcorcondev@gmail.com
# HR_APPLICANTS_IMAP_PASS=
# HR_APPLICANTS_IMAP_HOST=imap.gmail.com
# HR_APPLICANTS_IMAP_MAILBOX=INBOX

# --- Voice readback (window.claude.use("tts")) ---
# Functions only. Never put this in the shim, index.html, or a public env.
# Set on the HR Netlify site: Site settings → Environment variables.
# After adding or changing keys, trigger a redeploy so functions pick them up.
ELEVENLABS_API_KEY=
# Optional. Defaults to ElevenLabs Rachel (21m00Tcm4TlvDq8ikWAM).
# ELEVENLABS_VOICE_ID=
# Optional. Default eleven_multilingual_v2 (English / Filipino / Cebuano).
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

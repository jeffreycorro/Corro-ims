# CorConDev HR artifact — set these on the SEPARATE Netlify site
# (Site settings → Environment variables). Never commit real values.
# Do not put SUPABASE_SERVICE_ROLE in any browser file.

# Supabase project (may be the same project as the company portal, or dedicated).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Functions only. Never expose to the browser or the shim.
SUPABASE_SERVICE_ROLE=your-service-role-key

# Shared staff password + HMAC key for the httpOnly gate cookie.
# Use a long random string. Data functions refuse requests without a valid
# session (this cookie or a verified Supabase Auth user).
HR_GATE_SECRET=replace-with-a-long-random-string

# Optional: if set, this is the login password and HR_GATE_SECRET is used
# only to sign cookies (so you can rotate the password without a new HMAC key).
# HR_GATE_PASSWORD=

# Optional: allow email/password via Supabase Auth in addition to the gate
# password. Leave unset to use the shared password only.
# SUPABASE_AUTH_ENABLED=true

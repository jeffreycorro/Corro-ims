# CorConDev Finance artifact — set these on the SEPARATE Netlify site
# (Site settings → Environment variables). Never commit real values.
# Do not put SUPABASE_SERVICE_ROLE in any browser file.

# Same Supabase project as the company portal.
# Staff sign in with their portal email + password.
SUPABASE_URL=https://kfflyzprxcidmsdjhuej.supabase.co
SUPABASE_ANON_KEY=

# Functions only. Never expose to the browser or the shim.
SUPABASE_SERVICE_ROLE=

# Optional HMAC key for the httpOnly session cookie.
# If unset, the cookie is signed from SUPABASE_SERVICE_ROLE.
# FINANCE_SESSION_SECRET=

# Optional legacy shared-password wall. Default off. Leave unset.
# FINANCE_GATE_REQUIRED=
# FINANCE_GATE_PASSWORD=

# Supabase email/password is on by default when URL + anon key are set.
# SUPABASE_AUTH_ENABLED=

# Approver tab page password (evaluator already signed; Jeffrey final approval).
# If unset, the gate uses the same page password as the HR Approver tab.
# FINANCE_APPROVER_PASSWORD=

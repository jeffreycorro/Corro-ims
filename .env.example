# Public Supabase project values — safe for the browser.
# Never put the service role key or user passwords in frontend code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Live HR app (separate Netlify site). Used by the HR workspace CTA.
# NEXT_PUBLIC_HR_PORTAL_URL=https://corcondev-hr.netlify.app


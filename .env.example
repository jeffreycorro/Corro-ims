# Public Supabase project values — safe for the browser.
# Never put the service role key or user passwords in frontend code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only for local scripts / CI. Do not expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=

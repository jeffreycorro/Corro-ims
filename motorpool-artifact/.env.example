# CorConDev Motorpool artifact — set these on the SEPARATE Netlify site
# (Site settings → Environment variables). Never commit real values.
# Do not put SUPABASE_SERVICE_ROLE in any browser file.

# Supabase project (may be the same project as the company portal, or dedicated).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Functions only. Never expose to the browser or the shim.
SUPABASE_SERVICE_ROLE=your-service-role-key

# Optional shared staff password + HMAC key for the httpOnly gate cookie.
# If unset, the yard is open to anyone who has the link (real access control
# is who the URL is shared with, plus optional Netlify visitor protection).
# MOTORPOOL_GATE_SECRET=replace-with-a-long-random-string

# Optional: if set, this is the login password and MOTORPOOL_GATE_SECRET is
# used only to sign cookies.
# MOTORPOOL_GATE_PASSWORD=

# Optional: allow email/password via Supabase Auth in addition to the gate
# password. Leave unset to use the shared password only.
# SUPABASE_AUTH_ENABLED=true

# Office soft gate. SHA-256 hex of the office pass (64 lowercase hex chars).
# Never put the plaintext pass in this file, the app, README, or chat.
# Generate locally:  printf '%s' 'your-pass' | openssl dgst -sha256
# If unset, the owner can set a hash once from Office → one-time setup
# (stored on config/app; the field never echoes what was typed).
# MOTORPOOL_OFFICE_PASS_HASH=

# --- Optional later ---
# ANTHROPIC_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_DELEGATED_USER=

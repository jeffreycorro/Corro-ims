# CorConDev Motorpool artifact — set these on the SEPARATE Netlify site
# (Site settings → Environment variables). Never commit real values.
# Do not put SUPABASE_SERVICE_ROLE in any browser file.

# Same Supabase project as the company portal (corcondev-portal).
# Staff sign in with their portal email + password. There is no
# separate Motorpool site password in the default flow.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Functions only. Never expose to the browser or the shim.
# Used for docs/locks and (server-side) profile lookup.
SUPABASE_SERVICE_ROLE=your-service-role-key

# Optional HMAC key for the httpOnly Motorpool session cookie.
# If unset, the cookie is signed from SUPABASE_SERVICE_ROLE.
# Deprecated as a login password — ignored unless MOTORPOOL_GATE_REQUIRED=true.
# MOTORPOOL_GATE_SECRET=
# MOTORPOOL_SESSION_SECRET=

# Optional legacy shared-password wall. Default off. Leave unset.
# Only enable if you still need a second password in front of Auth.
# MOTORPOOL_GATE_REQUIRED=true
# MOTORPOOL_GATE_PASSWORD=

# Supabase email/password is on by default when URL + anon key are set.
# Set false only to disable Auth (not recommended).
# SUPABASE_AUTH_ENABLED=true

# Local / demo only. When true, the yard stays open even if Auth is configured.
# Leave unset on production (corcondev-motorpool).
# MOTORPOOL_OPEN_YARD=true

# Office soft gate. SHA-256 hex of the office pass (64 lowercase hex chars).
# Never put the plaintext pass in this file, the app, README, or chat.
# Generate locally:  printf '%s' 'your-pass' | openssl dgst -sha256
# If unset, the owner can set a hash once from Office → one-time setup
# (stored on config/app; the field never echoes what was typed).
# MOTORPOOL_OFFICE_PASS_HASH=

# --- Ask the log (window.claude.use("sample")) ---
# Functions only. Never put this in the shim, index.html, or a public env.
# Set on the Motorpool Netlify site: Site settings → Environment variables.
# After adding or changing keys, trigger a redeploy so functions pick them up.
ANTHROPIC_API_KEY=
# Optional model overrides. Default is claude-sonnet-4-5 for both tiers.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MODEL_COMPLEX=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_MAX_TOKENS_COMPLEX=8192

# --- Voice readback (window.claude.use("tts")) ---
# Functions only. Never commit the real key.
# Enables ElevenLabs speech for Ask the log when voice is on.
ELEVENLABS_API_KEY=
# Optional. Defaults to ElevenLabs Rachel (21m00Tcm4TlvDq8ikWAM).
# ELEVENLABS_VOICE_ID=
# Optional. Default eleven_multilingual_v2 (English / Filipino / Cebuano).
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Optional later ---
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_DELEGATED_USER=
